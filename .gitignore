# Personal data exports: never tracked.
/Your Amazon Orders/
/Your Returns & Refunds/
/Additional Data/
/Adafruit/

# The old in-checkout page and caches (search/ was removed in M3). A checkout
# that still has them must not leak them: search/index.html and
# search/images.json hold purchase data.
/search/

# The page shell build (data-free, but never committed: releases publish it).
/web/dist/

# Tooling
/web/node_modules/
.DS_Store
__pycache__/

# Facts about this checkout's exports (account, dates, counts).
/LOCAL.md

# Earlier exports kept after replacing them with newer ones.
/archive/

# Opt-out marker for a local pre-write hook; machine-local, never tracked.
/.no-pitch
